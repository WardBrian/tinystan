{
  "name": "tinystan",
  "version": "0.3.3",
  "description": "Typescript wrappers around Stan models built with emscripten",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./util": {
      "import": {
        "types": "./dist/util.d.mts",
        "default": "./dist/util.mjs"
      },
      "require": {
        "types": "./dist/util.d.cts",
        "default": "./dist/util.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "repository": "https://github.com/WardBrian/tinystan",
  "author": "Brian Ward",
  "license": "BSD-3-Clause",
  "scripts": {
    "test": "vitest run",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "format": "prettier . --write",
    "attw": "attw --pack .",
    "doc": "jsdoc2md --template ./doc/language-doc.hbs --plugin @godaddy/dmd --heading-depth=3 --configure ./doc/jsdoc2md.json --files src/*.ts "
  },
  "tsdown": {
    "entry": [
      "src/index.ts",
      "src/util.ts"
    ],
    "format": [
      "cjs",
      "esm"
    ],
    "attw": {
      "profile": "node16",
      "ignoreRules": [
        "false-export-default"
      ]
    },
    "dts": true,
    "sourcemap": true,
    "clean": true
  },
  "prettier": {
    "tabWidth": 2,
    "semi": true,
    "arrowParens": "avoid"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.15.3",
    "@babel/cli": "^7.25.9",
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-typescript": "^7.26.0",
    "@godaddy/dmd": "^1.0.4",
    "@vitest/coverage-v8": "^4.1.0",
    "jsdoc-babel": "^0.5.0",
    "jsdoc-to-markdown": "^9.0.5",
    "prettier": "^3.3.1",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
